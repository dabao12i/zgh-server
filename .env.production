# Application Port
PORT=3000

# Environment (development, staging, production)
NODE_ENV=production

# JWT Secret Key (a strong, random string)
JWT_SECRET=your_jwt_secret_key_prod

# JWT Token Expiration Time (e.g., 1h, 7d, 24h)
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN_SEC=604800

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=gzh_prod
DB_PORT=3306
